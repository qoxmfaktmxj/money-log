<% content_for :title, "대시보드" %>

<section class="page-header">
  <div>
    <h1 class="page-header__title">이번 달 요약</h1>
    <p class="page-header__meta"><%= month_label(@current_month) %> 기준으로 수입과 지출을 정리했습니다.</p>
  </div>

  <div class="actions">
    <%= link_to "새 거래 추가", new_transaction_path, class: "btn" %>
    <%= link_to "카테고리 관리", categories_path, class: "btn btn-secondary" %>
  </div>
</section>

<section class="summary-grid">
  <article class="card summary-card">
    <p class="summary-card__label">이번 달 수입</p>
    <div class="summary-card__value money money-income"><%= money(@income_total) %></div>
  </article>

  <article class="card summary-card">
    <p class="summary-card__label">이번 달 지출</p>
    <div class="summary-card__value money money-expense"><%= money(@expense_total) %></div>
  </article>

  <article class="card summary-card">
    <p class="summary-card__label">순잔액</p>
    <div class="summary-card__value <%= @net_balance.negative? ? "money money-expense" : "money money-income" %>"><%= money(@net_balance) %></div>
  </article>
</section>

<section class="layout-grid">
  <article class="card">
    <div class="stack">
      <div>
        <h2>최근 거래</h2>
        <p class="subtle">가장 최근에 기록한 내역입니다.</p>
      </div>
      <%= link_to "전체 보기", transactions_path, class: "btn btn-secondary" %>
    </div>

    <% if @recent_transactions.any? %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>거래일</th>
              <th>종류</th>
              <th>카테고리</th>
              <th>메모</th>
              <th>금액</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_transactions.each do |transaction| %>
              <tr>
                <td><%= l(transaction.happened_on) %></td>
                <td><span class="<%= kind_badge_class(transaction.kind) %>"><%= kind_name(transaction.kind) %></span></td>
                <td><%= link_to transaction.category.name, transaction_path(transaction) %></td>
                <td><%= transaction.memo.presence || "-" %></td>
                <td class="<%= amount_class(transaction.kind) %>"><%= money(transaction.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">아직 입력한 거래가 없습니다. 첫 거래를 추가해보세요.</div>
    <% end %>
  </article>

  <article class="card">
    <div class="stack">
      <div>
        <h2>카테고리별 합계</h2>
        <p class="subtle">이번 달에 실제로 사용한 카테고리만 보여줍니다.</p>
      </div>
    </div>

    <% if @category_totals.any? %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>종류</th>
              <th>카테고리</th>
              <th>합계</th>
            </tr>
          </thead>
          <tbody>
            <% @category_totals.each do |row| %>
              <tr>
                <td><span class="<%= kind_badge_class(row[:kind]) %>"><%= kind_name(row[:kind]) %></span></td>
                <td><%= row[:name] %></td>
                <td class="<%= amount_class(row[:kind]) %>"><%= money(row[:total]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">이번 달 거래가 아직 없습니다.</div>
    <% end %>
  </article>
</section>
