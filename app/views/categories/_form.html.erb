<article class="card form-card">
  <%= render "shared/form_errors", object: category %>

  <%= form_with model: category do |form| %>
    <div class="form-grid">
      <div class="field">
        <%= form.label :name, "이름" %>
        <%= form.text_field :name, placeholder: "예: 식비" %>
      </div>

      <div class="field">
        <%= form.label :kind, "종류" %>
        <%= form.select :kind, [["수입", "income"], ["지출", "expense"]], { prompt: "종류를 선택하세요" } %>
      </div>
    </div>

    <div class="stack">
      <%= form.submit category.persisted? ? "카테고리 저장" : "카테고리 만들기" %>
      <%= link_to "취소", category.persisted? ? category_path(category) : categories_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</article>
