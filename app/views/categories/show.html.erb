<% content_for :title, @category.name %>

<section class="page-header">
  <div>
    <h1 class="page-header__title"><%= @category.name %></h1>
    <p class="page-header__meta">이 분류에 연결된 내역 흐름을 모아봤어요. <span class="<%= kind_badge_class(@category.kind) %>"><%= kind_name(@category.kind) %></span></p>
  </div>

  <div class="actions">
    <%= link_to "수정하기", edit_category_path(@category), class: "btn" %>
    <%= link_to "분류 목록", categories_path, class: "btn btn-secondary" %>
  </div>
</section>

<section class="layout-grid">
  <article class="card">
    <h2>분류 요약</h2>
    <div class="meta-list">
      <div class="meta-item">
        <span class="subtle">연결된 내역 수</span>
        <strong><%= @category.transactions.count %>건</strong>
      </div>
      <div class="meta-item">
        <span class="subtle">지금까지 합계</span>
        <strong class="<%= amount_class(@category.kind) %>"><%= money(@total_amount) %></strong>
      </div>
      <div class="meta-item">
        <span class="subtle">이번 달 합계</span>
        <strong class="<%= amount_class(@category.kind) %>"><%= money(@current_month_total) %></strong>
      </div>
    </div>
  </article>

  <article class="card">
    <h2>최근 내역</h2>
    <% if @recent_transactions.any? %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>날짜</th>
              <th>내용</th>
              <th>금액</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_transactions.each do |transaction| %>
              <tr>
                <td><%= l(transaction.happened_on) %></td>
                <td><%= link_to transaction.memo.presence || "내역 자세히", transaction_path(transaction) %></td>
                <td class="<%= amount_class(transaction.kind) %>"><%= money(transaction.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">이 분류에 연결된 내역이 아직 없어요.</div>
    <% end %>
  </article>
</section>
