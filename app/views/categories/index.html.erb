<% content_for :title, "분류" %>

<section class="page-header">
  <div class="page-header__body">
    <h1 class="page-header__title">분류 관리</h1>
    <div class="page-header__inline">
      <p class="page-header__meta">자주 쓰는 수입·지출 분류를 미리 정리해두면 내역 입력이 더 쉬워져요.</p>
      <div class="actions">
        <%= link_to "추가", new_category_path, class: "btn btn-compact" %>
      </div>
    </div>
  </div>
</section>

<% income_categories, expense_categories = @categories.partition(&:income?) %>

<section class="category-columns">
  <% [["수입 분류", income_categories, "income"], ["지출 분류", expense_categories, "expense"]].each do |title, items, kind| %>
    <article class="card category-group">
      <div class="section-header">
        <div>
          <h2><%= title %></h2>
          <p class="subtle"><%= kind == "income" ? "들어오는 돈을 나눠 적는 분류예요." : "나가는 돈을 나눠 적는 분류예요." %></p>
        </div>
        <span class="<%= kind_badge_class(kind) %>"><%= items.size %>개</span>
      </div>

      <% if items.any? %>
        <div class="category-list">
          <% items.each do |category| %>
            <div class="category-row">
              <div class="category-row__main">
                <strong><%= link_to category.name, category_path(category) %></strong>
                <span class="subtle">연결된 내역 <%= category.transactions.size %>건</span>
              </div>
              <div class="table-actions">
                <%= link_to "수정하기", edit_category_path(category), class: "btn btn-secondary" %>
                <%= button_to "삭제하기", category_path(category), method: :delete, class: "btn btn-danger" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state"><%= kind == "income" ? "아직 수입 분류가 없어요." : "아직 지출 분류가 없어요." %></div>
      <% end %>
    </article>
  <% end %>
</section>
