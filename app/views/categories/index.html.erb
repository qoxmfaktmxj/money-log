<% content_for :title, "카테고리" %>

<section class="page-header">
  <div>
    <h1 class="page-header__title">카테고리 관리</h1>
    <p class="page-header__meta">수입과 지출 카테고리를 미리 정리해두면 거래 입력이 쉬워집니다.</p>
  </div>

  <div class="actions">
    <%= link_to "새 카테고리", new_category_path, class: "btn" %>
    <%= link_to "대시보드로", root_path, class: "btn btn-secondary" %>
  </div>
</section>

<article class="card">
  <% if @categories.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>이름</th>
            <th>종류</th>
            <th>거래 수</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td><%= link_to category.name, category_path(category) %></td>
              <td><span class="<%= kind_badge_class(category.kind) %>"><%= kind_name(category.kind) %></span></td>
              <td><%= category.transactions.size %>건</td>
              <td>
                <div class="table-actions">
                  <%= link_to "수정", edit_category_path(category), class: "btn btn-secondary" %>
                  <%= button_to "삭제", category_path(category), method: :delete, class: "btn btn-danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">등록된 카테고리가 없습니다. 첫 카테고리를 만들어보세요.</div>
  <% end %>
</article>
