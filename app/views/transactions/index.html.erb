<% content_for :title, "내역" %>

<section class="page-header">
  <div class="page-header__body">
    <h1 class="page-header__title">살림 내역</h1>
    <p class="page-header__meta">필요한 조건만 골라서 수입과 지출 흐름을 빠르게 살펴보세요.</p>
  </div>
</section>

<%= form_with url: transactions_path, method: :get, class: "filters" do |form| %>
  <div class="field filters__month">
    <%= form.label :month, "월" %>
    <%= form.select :month, options_for_select(@available_months, @filters[:month]), { include_blank: "전체" } %>
  </div>

  <div class="field filters__category">
    <%= form.label :category_id, "분류" %>
    <%= form.select :category_id, grouped_options_for_select(grouped_categories_for_select(@categories), @filters[:category_id]), { include_blank: "전체" } %>
  </div>

  <div class="field filters__kind">
    <%= form.label :kind, "구분" %>
    <%= form.select :kind, options_for_select([["수입", "income"], ["지출", "expense"]], @filters[:kind]), { include_blank: "전체" } %>
  </div>

  <div class="field filters__query">
    <%= form.label :query, "내용 검색" %>
    <%= form.search_field :query, value: @filters[:query], placeholder: "예: 점심값" %>
  </div>

  <div class="actions filters__actions">
    <%= form.submit "필터 적용" %>
    <%= link_to "전체 보기", transactions_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<section class="result-strip result-strip--with-action">
  <div class="result-pill">
    <span class="result-pill__label">총 건수</span>
    <strong><%= @transaction_count %>건</strong>
  </div>
  <div class="result-pill">
    <span class="result-pill__label">수입 합계</span>
    <strong class="money money-income"><%= money(@income_total) %></strong>
  </div>
  <div class="result-pill">
    <span class="result-pill__label">지출 합계</span>
    <strong class="money money-expense"><%= money(@expense_total) %></strong>
  </div>
  <div class="result-strip__action">
    <%= link_to "추가", new_transaction_path, class: "btn btn-compact" %>
  </div>
</section>

<article class="card">
  <% if @transactions.any? %>
    <div class="table-wrapper">
      <table class="table-entries">
        <thead>
          <tr>
            <th>날짜</th>
            <th>구분</th>
            <th>분류</th>
            <th>내용</th>
            <th>금액</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |transaction| %>
            <tr>
              <td data-label="날짜"><%= l(transaction.happened_on) %></td>
              <td data-label="구분"><span class="<%= kind_badge_class(transaction.kind) %>"><%= kind_name(transaction.kind) %></span></td>
              <td data-label="분류"><%= transaction.category.name %></td>
              <td data-label="내용"><%= transaction.memo.presence || "-" %></td>
              <td data-label="금액" class="<%= amount_class(transaction.kind) %>"><%= money(transaction.amount) %></td>
              <td data-label="관리">
                <div class="table-actions">
                  <%= link_to "자세히", transaction_path(transaction), class: "btn btn-secondary" %>
                  <%= link_to "수정하기", edit_transaction_path(transaction), class: "btn btn-secondary" %>
                  <%= button_to "삭제하기", transaction_path(transaction), method: :delete, class: "btn btn-danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">조건에 맞는 내역이 없어요. 필터를 조금 다르게 골라보세요.</div>
  <% end %>
</article>
