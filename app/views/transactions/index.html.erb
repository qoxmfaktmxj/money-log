<% content_for :title, "거래 내역" %>

<section class="page-header">
  <div>
    <h1 class="page-header__title">거래 내역</h1>
    <p class="page-header__meta">월, 카테고리, 종류, 메모 검색으로 원하는 거래만 빠르게 찾을 수 있습니다.</p>
  </div>

  <div class="actions">
    <%= link_to "새 거래", new_transaction_path, class: "btn" %>
    <%= link_to "대시보드로", root_path, class: "btn btn-secondary" %>
  </div>
</section>

<%= form_with url: transactions_path, method: :get, class: "filters" do |form| %>
  <div class="actions filters__actions">
    <%= form.submit "조회" %>
    <%= link_to "초기화", transactions_path, class: "btn btn-secondary" %>
  </div>

  <div class="field filters__month">
    <%= form.label :month, "월" %>
    <%= form.select :month, options_for_select(@available_months, @filters[:month]), { include_blank: "전체" } %>
  </div>

  <div class="field filters__category">
    <%= form.label :category_id, "카테고리" %>
    <%= form.select :category_id, options_for_select(@categories.map { |category| ["#{kind_name(category.kind)} · #{category.name}", category.id] }, @filters[:category_id]), { include_blank: "전체" } %>
  </div>

  <div class="field filters__kind">
    <%= form.label :kind, "종류" %>
    <%= form.select :kind, options_for_select([["수입", "income"], ["지출", "expense"]], @filters[:kind]), { include_blank: "전체" } %>
  </div>

  <div class="field filters__query">
    <%= form.label :query, "메모 검색" %>
    <%= form.search_field :query, value: @filters[:query], placeholder: "예: 점심" %>
  </div>
<% end %>

<article class="card">
  <% if @transactions.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>거래일</th>
            <th>종류</th>
            <th>카테고리</th>
            <th>메모</th>
            <th>금액</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |transaction| %>
            <tr>
              <td><%= l(transaction.happened_on) %></td>
              <td><span class="<%= kind_badge_class(transaction.kind) %>"><%= kind_name(transaction.kind) %></span></td>
              <td><%= transaction.category.name %></td>
              <td><%= transaction.memo.presence || "-" %></td>
              <td class="<%= amount_class(transaction.kind) %>"><%= money(transaction.amount) %></td>
              <td>
                <div class="table-actions">
                  <%= link_to "보기", transaction_path(transaction), class: "btn btn-secondary" %>
                  <%= link_to "수정", edit_transaction_path(transaction), class: "btn btn-secondary" %>
                  <%= button_to "삭제", transaction_path(transaction), method: :delete, class: "btn btn-danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">조건에 맞는 거래가 없습니다.</div>
  <% end %>
</article>
