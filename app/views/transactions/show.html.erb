<% content_for :title, "거래 상세" %>

<section class="page-header">
  <div>
    <h1 class="page-header__title">거래 상세</h1>
    <p class="page-header__meta"><%= l(@transaction.happened_on) %>에 기록한 내역입니다.</p>
  </div>

  <div class="actions">
    <%= link_to "수정", edit_transaction_path(@transaction), class: "btn" %>
    <%= link_to "목록으로", transactions_path, class: "btn btn-secondary" %>
  </div>
</section>

<article class="card form-card">
  <div class="meta-list">
    <div class="meta-item">
      <span class="subtle">종류</span>
      <span class="<%= kind_badge_class(@transaction.kind) %>"><%= kind_name(@transaction.kind) %></span>
    </div>
    <div class="meta-item">
      <span class="subtle">금액</span>
      <strong class="<%= amount_class(@transaction.kind) %>"><%= money(@transaction.amount) %></strong>
    </div>
    <div class="meta-item">
      <span class="subtle">카테고리</span>
      <strong><%= link_to @transaction.category.name, category_path(@transaction.category) %></strong>
    </div>
    <div class="meta-item">
      <span class="subtle">거래일</span>
      <strong><%= l(@transaction.happened_on) %></strong>
    </div>
    <div class="meta-item">
      <span class="subtle">메모</span>
      <strong><%= @transaction.memo.presence || "-" %></strong>
    </div>
  </div>
</article>
